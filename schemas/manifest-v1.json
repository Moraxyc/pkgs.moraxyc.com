{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pkgs.moraxyc.com/schemas/manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project", "release_tag", "packages"],
  "properties": {
    "schema": {"const": 1, "type": "integer"},
    "project": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "release_tag": {"$ref": "#/$defs/segment"},
    "packages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/package"}}
  },
  "$defs": {
    "segment": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.+~\\-]*$", "not": {"pattern": "\\.\\."}},
    "package": {
      "type": "object", "additionalProperties": false,
      "required": ["Package", "Version", "Architecture", "Filename", "Size", "SHA256", "Description"],
      "properties": {
        "Package": {"type": "string", "pattern": "^[a-z0-9][a-z0-9+.-]+$"},
        "Version": {"type": "string", "minLength": 1},
        "Architecture": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "Filename": {"allOf": [{"$ref": "#/$defs/segment"}, {"pattern": "\\.deb$"}]},
        "Size": {"type": "integer", "minimum": 1},
        "SHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "Depends": {"type": "string", "pattern": "^[^\u0000-\u001f\u007f]*$"},
        "Description": {"type": "string", "minLength": 1}
      }
    }
  }
}
